<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1e293b"
            android:id="@+id/noti_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Calis Device Receiver"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/noti_badge_container"
            android:background="@drawable/bg_noti_badge_border"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/noti_badge_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_noti_dot"
                android:contentDescription="Status Indicator Dot"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:id="@+id/noti_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTED"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#64748b"
        android:id="@+id/noti_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Classroom: Ready"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/noti_waves_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_noti_waves"
            android:scaleType="fitCenter"
            android:contentDescription="Waves Icon"/>
        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <ImageView
            android:id="@+id/noti_esp32_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_noti_esp32"
            android:scaleType="fitCenter"
            android:contentDescription="ESP32 CPU Icon"/>
        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <ImageView
            android:id="@+id/noti_dotted_line"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/bg_noti_dotted_line"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:contentDescription="Dotted Line"/>
        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="42dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/noti_btn_connect"
                android:background="@drawable/bg_noti_btn_filled_blue"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/noti_btn_connect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/noti_btn_disconnect"
                android:background="@drawable/bg_noti_btn_outlined_blue"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0284c7"
                    android:id="@+id/noti_btn_disconnect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnect"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/noti_btn_enable"
                android:background="@drawable/bg_noti_btn_filled_blue"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable Bluetooth"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
