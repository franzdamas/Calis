<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Title and Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/noti_exp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calis Device Receiver"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#1E293B" />

        <!-- Status Pill Badge -->
        <LinearLayout
            android:id="@+id/noti_exp_badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_noti_badge_border"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/noti_exp_badge_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_noti_dot"
                android:contentDescription="Status Indicator Dot" />

            <TextView
                android:id="@+id/noti_exp_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="CONNECTED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#10B981" />
        </LinearLayout>
    </LinearLayout>

    <!-- Classroom Info -->
    <TextView
        android:id="@+id/noti_exp_classroom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Classroom: Ready"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#334155" />

    <TextView
        android:id="@+id/noti_exp_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Status: Connected"
        android:textSize="11sp"
        android:textColor="#64748B" />

    <!-- CD Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- 1. Wi-Fi 3 Waves Icon -->
        <ImageView
            android:id="@+id/noti_exp_waves_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_noti_waves"
            android:contentDescription="Waves Icon" />

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- 2. ESP32 CPU Icon -->
        <ImageView
            android:id="@+id/noti_exp_esp32_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_noti_esp32"
            android:contentDescription="ESP32 CPU Icon" />

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- 3. Dotted line -->
        <ImageView
            android:id="@+id/noti_exp_dotted_line"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:src="@drawable/bg_noti_dotted_line"
            android:scaleType="fitCenter"
            android:contentDescription="Dotted Line" />

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- 4. Action Buttons -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="42dp">

            <!-- Connect Button -->
            <LinearLayout
                android:id="@+id/noti_exp_btn_connect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_noti_btn_filled_blue"
                android:gravity="center">

                <TextView
                    android:id="@+id/noti_exp_btn_connect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Disconnect Button -->
            <LinearLayout
                android:id="@+id/noti_exp_btn_disconnect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_noti_btn_outlined_blue"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/noti_exp_btn_disconnect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnect"
                    android:textColor="#0284C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Enable Bluetooth Button -->
            <LinearLayout
                android:id="@+id/noti_exp_btn_enable"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_noti_btn_filled_blue"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable Bluetooth"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Divider Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#E2E8F0" />

    <!-- Row 2: Terminate (Red Outlined) & Session Actions (Start/Stop) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Terminate Button (Red Outlined, Left) -->
        <LinearLayout
            android:id="@+id/noti_exp_btn_terminate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/bg_noti_btn_outlined_red"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminate"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Start/Stop Session Button Container (Right) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4">

            <!-- Start Session Button -->
            <LinearLayout
                android:id="@+id/noti_exp_btn_session_start"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_noti_btn_filled_blue"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/noti_exp_btn_session_start_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_noti_play"
                    android:contentDescription="Start Session" />

                <TextView
                    android:id="@+id/noti_exp_btn_session_start_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Start Session"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- End Session Button -->
            <LinearLayout
                android:id="@+id/noti_exp_btn_session_end"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@drawable/bg_noti_btn_outlined_blue"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/noti_exp_btn_session_end_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_noti_stop"
                    android:contentDescription="End Session" />

                <TextView
                    android:id="@+id/noti_exp_btn_session_end_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Stop Session"
                    android:textColor="#0284C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
